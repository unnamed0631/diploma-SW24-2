# Public Expo variables are inlined into the client bundle at build time.
# Never put secrets in this file or any other app env file. In particular,
# JWT_SECRET must never be in app env: non-public variables are not inlined,
# and secrets must stay server-side.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SCHEME=coolfitness

# PoseTracker key used by the camera-tracking WebView.
# get it from https://app.posetracker.com/pose_tracker/tracking
EXPO_PUBLIC_POSETRACKER_API_KEY=
